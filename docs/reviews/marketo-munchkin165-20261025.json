  "wire_constructors": {
    "init": "g.notifyPrefix=q.protocol+//+m+.mktoresp.com/ before J(g,a) configuration overrides",
    "x": "Builds webevents/<event>?_mchNc=Date time; supplies stable _mchHo/_mchPo/_mchPc and version165. IDs/token/path/name fields can be omitted in native/coercion branches.",
    "Q": "Concatenates URI-encoded query objects and uses bodyless navigator.sendBeacon or GET XHR/image.",
    "I": "Skips null/functions, retains/coerces other native values and encodes names/values."
  },
  "selectors": {
    "host_suffixes": [
      "mktoresp.com"
    ],
