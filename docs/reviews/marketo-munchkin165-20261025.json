      {
        "name": "_mchVr",
        "values": [
          "165"
        ]
      }
    ]
  },
  "contracts": [
    {
      "scope": "url",
      "contract": {
        "name": "_mchVr",
        "requirement": "optional",
        "severity": "warning",
        "allow_empty": true,
        "description": "The literal version marker identifies the pinned producer only. This is selection evidence, not a receiver-wide version enum."
      }
    },
    {
      "scope": "url",
      "contract": {
        "name": "_mchNc",
        "requirement": "optional",
        "severity": "warning",
        "allow_empty": true,
        "description": "The source emits this query carrier in the generated route. Values remain open, with no timestamp spelling, time-window or cache-uniqueness rule."
      }
    },
    {
      "scope": "url",
      "contract": {
        "name": "_mchHo",
        "requirement": "recommended",
        "severity": "warning",
        "allow_empty": true,
        "description": "The actual x constructor supplies the current page hostname before Q serializes it. Only key presence is advised; repeated or empty configured values remain open."
      }
    },
    {
      "scope": "url",
      "contract": {
        "name": "_mchPo",
        "requirement": "recommended",
        "severity": "warning",
        "allow_empty": true,
        "description": "The actual constructor supplies the page port, commonly an empty string. No nonempty or numeric-port grammar is imposed."
      }
    },
    {
      "scope": "url",
      "contract": {
        "name": "_mchPc",
        "requirement": "recommended",
        "severity": "warning",
        "allow_empty": true,
        "description": "The actual constructor supplies the page protocol. Only key presence is advised, without an inferred scheme enum or HTTPS-only requirement."
      }
    },
    {
      "scope": "http",
      "contract": {
        "name": "method",
        "requirement": "recommended",
        "severity": "warning",
        "format": {
          "kind": "enum",
          "values": [
            "GET",
            "POST"
          ]
        },
        "description": "Q uses bodyless sendBeacon POST, or GET through XHR/image fallback. No body or MIME requirement is imposed."
      }
    }
  ],
  "remaining_requirements": [
    {
      "requirement": "HTTP requiredness, accepted values and processing behavior beyond the three stable query-key presences",
      "reason": "The public SDK emits native/coerced or omitted ID, cookie, name, path and link values. Full receiver acceptance is not published or tested."
    },
    {
      "requirement": "Munchkin ID issuance, cookie token validity, account state and tenant existence",
      "reason": "Default host construction is source-backed, but authored IDs are neither resolved as real tenants nor sent. A DNS-resolving root does not verify any account."
    },
    {
      "requirement": "URL, link, identifier, port, protocol, timestamp or token grammar and duplicate-selection policy",
      "reason": "Null/functions can be omitted; other native values URI-coerce. Delegated click lacks _mchLr, API visit can omit custom name and API functions can omit path/link fields. tel/mailto remain valid links."
    },
    {
      "requirement": "Other Munchkin versions, revisions, endpoints and custom notifyPrefix destinations",
      "reason": "Only canonical visit/click paths with literal165 and the _mchNc carrier are selected. A later revision might reuse wire marker165, so the current hash/revision needs re-review when published bytes change."
    },
    {
      "requirement": "Cookie/no-cookie, opt-out and tracking permission state outside the captured artifact",
      "reason": "Three offline scenarios correctly produce no request. The validator does not infer a missing event from absence of a capture."
    },
    {
      "requirement": "Body or MIME contract",
      "reason": "The actual beacon uses POST without a body, while XHR/image use GET. All event fields are query-carried; no body schema is imposed."
    }
  ],
