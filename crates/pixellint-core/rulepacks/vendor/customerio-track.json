{
  "id": "vendor/customerio-track",
  "display_name": "Customer.io Track v1 events",
  "vendor": "customerio",
  "docs": "https://docs.customer.io/integrations/api/track/tag/track-events/track/",
  "source_level": "official_vendor",
  "description": "Customer.io Track v1 event captures. Check event fields and deduplication identifiers while preserving official numeric anonymous IDs, optional identity and legacy invites.",
  "match": {
    "hosts": [
      "track.customer.io",
      "track-eu.customer.io"
    ],
    "paths": [
      "/api/v1/events"
    ],
    "path_patterns": [
      "/api/v1/customers/[^/]+/events"
    ],
    "json_paths": [
      {
        "any_of": [
          "anonymous_id",
          "id"
        ]
      },
      "name"
    ],
    "artifact_kinds": [
      "url",
      "vast",
      "postback",
      "request",
      "unknown"
    ]
  },
  "body": [
    {
      "params": [
        {
          "name": "",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "object"
        },
        {
          "name": "name",
          "requirement": "required",
          "allow_empty": false,
          "json_type": "string",
          "normalization": "trim",
          "max_byte_length": 100,
          "doc": "https://docs.customer.io/integrations/data-in/connections/classic-api/invalid-api-requests/"
        },
        {
          "name": "data",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "object",
          "max_compact_bytes": 100000,
          "doc": "https://docs.customer.io/integrations/data-in/connections/classic-api/invalid-api-requests/"
        },
        {
          "name": "id",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "string",
          "description": "Optional string event identifier. A malformed or nonuppercase ULID is replaced by the receiver, losing retry deduplication; the event is not rejected solely for this format.",
          "doc": "https://docs.customer.io/messaging/people/events/"
        },
        {
          "name": "timestamp",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "integer"
        },
        {
          "name": "type",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "string",
          "description": "Unknown non-page/screen values default to event; no closed enum is imposed."
        },
        {
          "name": "anonymous_id",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": [
            "string",
            "number"
          ],
          "doc": "https://raw.githubusercontent.com/customerio/customerio-node/4b9a980b790b937aea2a68d7d11d534c204edd13/lib/track.ts",
          "description": "The official Node sender accepts string or number anonymous identifiers and forwards populated values unchanged. Empty, omitted and Ruby nil invite identifiers retain the documented legacy behavior. The OpenAPI string-only branch does not describe all official SDK output."
        },
        {
          "name": "data.from_address",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "string"
        },
        {
          "name": "data.recipient",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "string"
        },
        {
          "name": "data.reply_to",
          "requirement": "optional",
          "allow_empty": true,
          "json_type": "string"
        }
      ],
      "rules": [
        {
          "code": "vendor.customerio-track.body.id.invalid",
          "kind": "format",
          "param": "id",
          "format": {
            "kind": "regex",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "condition": {
            "kind": "json_type",
            "param": "id",
            "json_type": "string"
          },
          "severity": "warning",
          "doc": "https://docs.customer.io/messaging/people/events/",
          "message": "Use an uppercase ULID to preserve event deduplication. Customer.io replaces other string values with a new ID and can no longer identify a retry of this event. Event acceptance and deduplication are distinct."
        }
      ]
    }
  ],
  "http": [
    {
      "params": [
        {
          "name": "method",
          "requirement": "required",
          "allow_empty": true,
          "json_type": "string",
          "format": {
            "kind": "enum",
            "values": [
              "POST"
            ]
          }
        },
        {
          "name": "content_type",
          "requirement": "required",
          "allow_empty": true,
          "json_type": "string",
          "format": {
            "kind": "enum",
            "values": [
              "application/json"
            ]
          }
        },
        {
          "name": "body",
          "requirement": "required",
          "allow_empty": true
        },
        {
          "name": "authorization_scheme",
          "requirement": "required",
          "allow_empty": true,
          "json_type": "string",
          "format": {
            "kind": "enum",
            "values": [
              "basic"
            ]
          }
        },
        {
          "name": "basic_auth.username",
          "requirement": "required",
          "allow_empty": false,
          "json_type": "string"
        },
        {
          "name": "basic_auth.password",
          "requirement": "required",
          "allow_empty": false,
          "json_type": "string"
        },
        {
          "name": "headers.authorization",
          "json_type": "string",
          "requirement": "required",
          "format": {
            "kind": "regex",
            "pattern": "(?i)^Basic +(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "description": "HTTP Basic credentials use the standard Base64 alphabet and padding."
        },
        {
          "name": "basic_auth.has_colon",
          "json_type": "boolean",
          "requirement": "required",
          "format": {
            "kind": "enum",
            "values": [
              "true"
            ]
          },
          "description": "These APIs require a key and secret separated by a colon; colonless legacy keys are not this profile."
        }
      ]
    }
  ]
}
