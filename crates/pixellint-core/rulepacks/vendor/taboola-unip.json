{
  "id": "vendor/taboola-unip",
  "display_name": "Taboola unip event pixel",
  "vendor": "taboola",
  "description": "Taboola account-scoped /log/3/unip requests, including SDK events, subscription markers and the public SDK logger form/beacon transport. Checks generated clocks, engagement metrics and flags. Custom event names and properties, opaque session data and the literal null referrer remain valid. New producer checks are advisory.",
  "source_level": "official_vendor",
  "docs": "https://developers.taboola.com/pixel/docs/verification-network-traffic",
  "match": {
    "host_suffixes": [
      "taboola.com"
    ],
    "path_patterns": [
      "^/[^/]+/log/3/unip/?$"
    ]
  },
  "params": [
    {
      "name": "en",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "Taboola documents en on conversion event requests and says other unip requests are internal traffic. Because the endpoint matcher includes both, absence is a warning rather than an asserted transport failure.",
      "fix_hint": "Send `en` with the Realize event name, such as `page_view` or `purchase`.",
      "doc": "https://developers.taboola.com/pixel/docs/verification-network-traffic"
    },
    {
      "name": "revenue",
      "format": {
        "kind": "regex",
        "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
      },
      "description": "It is the conversion value. Taboola documents an integer or decimal number, with no commas. Page views omit it.",
      "fix_hint": "Send a number, such as `9.99`, or drop the pair on a page view.",
      "doc": "https://developers.taboola.com/pixel/docs/track-dynamic-conversion-values"
    },
    {
      "name": "currency",
      "format": {
        "kind": "enum",
        "values": [
          "AUD",
          "BRL",
          "CAD",
          "CNY",
          "EUR",
          "GBP",
          "HKD",
          "ILS",
          "INR",
          "JPY",
          "KRW",
          "MXN",
          "NZD",
          "RUB",
          "SGD",
          "THB",
          "TRY",
          "USD",
          "ZAR"
        ]
      },
      "description": "It is the revenue currency. Taboola documents a fixed list of three-letter codes, case-sensitive. Omit it to use the account default.",
      "fix_hint": "Use a documented code such as `USD`.",
      "doc": "https://developers.taboola.com/pixel/docs/track-dynamic-conversion-values"
    },
    {
      "name": "quantity",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "description": "It is the item quantity in the order. Taboola documents an integer.",
      "fix_hint": "Send an integer quantity, such as `3`.",
      "doc": "https://developers.taboola.com/pixel/docs/track-dynamic-conversion-values"
    },
    {
      "name": "orderid",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is an order ID from the advertiser CRM. Taboola documents it as optional. Purchase fires often send it.",
      "fix_hint": "Set orderid to the CRM order ID, or drop the pair.",
      "doc": "https://developers.taboola.com/pixel/docs/track-dynamic-conversion-values"
    },
    {
      "name": "publisher_id",
      "description": "The SDK routes events through a numeric account path.",
      "requirement": "recommended",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "tim",
      "description": "Generated event time in Unix milliseconds. No freshness window is inferred.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "tos",
      "description": "Generated visible time on site in milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "ssd",
      "description": "Observed site-depth counter.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "scd",
      "description": "Maximum scroll percentage; no unstated 100 percent ceiling is imposed.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "est",
      "description": "Generated session-start milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "msa",
      "description": "Generated maximum scrollable amount.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "ce",
      "description": "Pinned producer marker.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "subscr"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "psb",
      "description": "Pinned producer marker.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "true"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "cis",
      "description": "Pinned producer marker.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "q",
          "h",
          "cq",
          "ls"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "ga",
      "description": "Pinned producer marker.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "true",
          "false",
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "isls",
      "description": "Pinned producer marker.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "true",
          "false"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "item-url",
      "description": "Optional page-location override.",
      "requirement": "optional",
      "format": {
        "kind": "url"
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    },
    {
      "name": "surl",
      "description": "Optional page-location override.",
      "requirement": "optional",
      "format": {
        "kind": "url"
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
    }
  ],
  "rules": [],
  "path_pattern": "^/(?<publisher_id>[^/]+)/log/3/unip/?$",
  "http": {
    "params": [
      {
        "name": "method",
        "description": "Pinned producer transport.",
        "requirement": "recommended",
        "format": {
          "kind": "enum",
          "values": [
            "GET",
            "POST"
          ]
        },
        "severity": "warning",
        "source_level": "official_template",
        "doc": "https://cdn.taboola.com/libtrc/unip/1234567/tfa.js"
      }
    ],
    "rules": []
  }
}
