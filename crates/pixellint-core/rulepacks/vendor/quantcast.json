        "values": [
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "_gam",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "a",
          "c"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    }
  ],
  "rules": [],
  "http": {
    "params": [
      {
        "name": "method",
        "description": "Pinned producer transport.",
        "requirement": "recommended",
        "format": {
          "kind": "enum",
          "values": [
            "GET",
            "POST"
          ]
        },
        "severity": "warning",
        "source_level": "official_template",
        "doc": "https://secure.quantserve.com/quant.js"
      }
    ],
    "rules": []
  }
}
