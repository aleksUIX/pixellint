      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "qjs",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "dst",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "uht",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1",
          "2",
          "u"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "fpan",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
