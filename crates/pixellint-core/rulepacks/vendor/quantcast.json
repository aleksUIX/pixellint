{
  "id": "vendor/quantcast",
  "display_name": "Quantcast Measure pixel",
  "description": "Quantcast matrix /pixel collectors, including the pinned SDK measurement, denied-consent and Apple-vendor alias hosts. Checks source flags, clock spelling, hashing sentinels and GET/POST beacons. Signed revenue, empty identities and arbitrary event properties remain valid. New producer checks are advisory.",
  "vendor": "quantcast",
  "source_level": "official_vendor",
  "docs": "https://help.quantcast.com/docs/inspect-your-tag",
  "param_style": "matrix",
  "match": {
    "hosts": [
      "pixel.quantserve.com",
      "secure.quantserve.com",
      "pixel.quantcount.com",
      "prreqcroab.icu"
    ],
    "paths": [
      "/pixel"
    ],
    "path_prefixes": [
      "/pixel;"
    ]
  },
  "params": [
    {
      "name": "a",
      "requirement": "required",
      "format": {
        "kind": "regex",
        "pattern": "^p-.+$"
      },
      "description": "It is the Quantcast p-code. Quantcast documents Measure tag calls with `a=p-` plus that identifier.",
      "fix_hint": "Set `a` to the p-code from the Quantcast account, starting with `p-`.",
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "labels",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the audience segment or event label. Quantcast documents Measure tag calls with labels=_fp.event. plus the segment name.",
      "fix_hint": "Set labels to the Event Manager segment, or drop the empty pair.",
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "orderid",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the order identifier on a purchase confirmation. Quantcast documents orderid on the Measure tag call.",
      "fix_hint": "Set orderid to the order ID, or drop the empty pair.",
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "revenue",
      "format": {
        "kind": "regex",
        "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
      },
      "description": "It is the order value. Quantcast documents revenue as a number on the Measure tag call.",
      "fix_hint": "Set revenue to a number such as 100, with no currency symbol.",
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "url",
      "format": {
        "kind": "url"
      },
      "description": "It is the page URL the tag fired on. Quantcast documents url on the Measure tag call.",
      "fix_hint": "Set url to the absolute page URL, encoded on the tag.",
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "ref",
      "description": "Quantcast shows ref as an absolute referrer URL in its published beacon example.",
      "allow_empty": true,
      "source_level": "official_template",
      "format": {
        "kind": "url"
      },
      "doc": "https://help.quantcast.com/docs/inspect-your-tag"
    },
    {
      "name": "r",
      "description": "Producer random integer.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "minimum": 0,
      "maximum": 2147483647,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "et",
      "description": "Producer Unix milliseconds, without a freshness window.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "tzo",
      "description": "Signed timezone offset in minutes.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "ourl",
      "description": "Original page URL when a URL override is present.",
      "requirement": "optional",
      "format": {
        "kind": "url"
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "uh",
      "description": "SHA-256 identity or the producer denied-consent sentinel u.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^(?:[a-fA-F0-9]{64}|u)$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "rf",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1",
          "2",
          "3",
          "4",
          "6"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://secure.quantserve.com/quant.js"
    },
    {
      "name": "ns",
      "description": "Pinned producer state or flag.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
