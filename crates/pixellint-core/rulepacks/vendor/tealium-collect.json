      "allow_empty": true
    },
    {
      "name": "tealium_visitor_id",
      "requirement": "optional",
      "allow_empty": true,
      "description": "AudienceStream needs visitor context; known IDs and anonymous GUIDs are alternatives. No universal GUID requirement is inferred."
