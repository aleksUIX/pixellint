            "kind": "non_empty"
          },
          "description": "Google click ID. A click-ID upload needs exactly one of `gclid`, `gbraid`, or `wbraid`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "string",
          "null_as_missing": true
        },
        {
          "name": "gbraid",
          "format": {
            "kind": "non_empty"
          },
          "description": "App-to-web click identifier from iOS. Alternative to `gclid`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "string",
          "null_as_missing": true
        },
        {
          "name": "wbraid",
          "format": {
            "kind": "non_empty"
          },
          "description": "Web-to-app click identifier. Alternative to `gclid`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "string",
          "null_as_missing": true
