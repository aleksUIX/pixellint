          "fix_hint": "Use the three-letter code, such as `USD`, together with `conversionValue`.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v24/ClickConversion",
          "json_type": "string",
          "aliases": [
            "currency_code"
          ],
          "null_as_missing": true
        },
        {
          "name": "conversionValue",
          "format": {
            "kind": "regex",
            "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|NaN|-?Infinity)$"
          },
          "description": "It is the conversion value for the advertiser. Google documents it together with `currencyCode`.",
          "fix_hint": "Send a number such as `1.0`, with no currency symbol, together with `currencyCode`.",
          "doc": "https://protobuf.dev/programming-guides/json/",
          "json_type": [
            "number",
            "string"
          ],
          "aliases": [
            "conversion_value"
          ],
          "null_as_missing": true
        },
        {
          "name": "userIpAddress",
          "format": {
            "kind": "ip"
          },
          "description": "It is the customer IP on the landing page after the click, sent unhashed. Google documents the device address, not the advertiser server.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ClickConversion",
          "json_type": "string",
          "aliases": [
            "user_ip_address"
          ],
          "null_as_missing": true
