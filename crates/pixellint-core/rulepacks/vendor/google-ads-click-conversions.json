{
  "id": "vendor/google-ads-click-conversions",
  "display_name": "Google Ads click conversion upload",
  "description": "Offline and enhanced-for-leads click conversions posted to the Google Ads API UploadClickConversions method, including the JSON Conversion payload. Conversion adjustments are vendor/google-ads-conversion-adjustments. The image pixel on /pagead/conversion is a different pack.",
  "vendor": "google",
  "source_level": "official_vendor",
  "docs": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
  "match": {
    "hosts": [
      "googleads.googleapis.com"
    ],
    "path_contains": [
      "uploadClickConversions"
    ],
    "json_paths": [
      {
        "any_of": [
          "conversions[].conversionAction",
          "conversions[].conversion_action",
          "conversions[].conversionDateTime",
          "conversions[].conversion_date_time"
        ]
      },
      {
        "path": "conversions[].callerId",
        "excludes": ".+"
      },
      {
        "path": "conversions[].callStartDateTime",
        "excludes": ".+"
      },
      {
        "path": "conversionAdjustments[].adjustmentType",
        "excludes": ".+"
      }
    ]
  },
  "body": [
    {
      "params": [
        {
          "name": "conversions",
          "requirement": "required",
          "description": "UploadClickConversions requires a `conversions` array.",
          "fix_hint": "Send at least one ClickConversion in `conversions`.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v24/UploadClickConversionsRequest",
          "json_type": "array",
          "min_items": 1,
          "max_items": 2000,
          "null_as_missing": true
        },
        {
          "name": "partialFailure",
          "requirement": "required",
          "format": {
            "kind": "enum",
            "values": [
              "true"
            ]
          },
          "description": "Google documents `partial_failure` as required, and the upload guides say to always send true.",
          "fix_hint": "Set `partialFailure` to `true`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "boolean",
          "aliases": [
            "partial_failure"
          ],
          "null_as_missing": true
        },
        {
          "name": "conversions[]",
          "description": "The vendor documents `conversions[]` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "object"
        },
        {
          "name": "validateOnly",
          "description": "The vendor documents `validateOnly` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "boolean",
          "aliases": [
            "validate_only"
          ],
          "null_as_missing": true
        },
        {
          "name": "jobId",
          "description": "The vendor documents `jobId` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UploadClickConversionsRequest",
          "json_type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 2147483647,
          "aliases": [
            "job_id"
          ],
          "null_as_missing": true,
          "format": {
            "kind": "regex",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
          },
          "multiple_of": 1,
          "numeric_strings": true
        },
        {
          "name": "",
          "description": "The vendor documents `` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "object"
        }
      ],
      "rules": []
    },
    {
