          "requirement": "required",
          "format": {
            "kind": "non_empty"
          },
          "description": "It is the conversion action resource name, and every uploaded click conversion requires it.",
          "fix_hint": "Set `conversionAction` to `customers/{id}/conversionActions/{id}`.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v24/ClickConversion",
          "json_type": "string",
          "aliases": [
            "conversion_action"
          ],
          "null_as_missing": true
        },
        {
          "name": "conversionDateTime",
          "requirement": "required",
          "format": {
            "kind": "regex",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "description": "Google documents the conversion time with a timezone offset as `yyyy-mm-dd hh:mm:ss+|-hh:mm`.",
          "fix_hint": "Send a timestamp such as `2026-08-21 12:00:00+00:00`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-offline",
          "json_type": "string",
          "aliases": [
            "conversion_date_time"
          ],
          "null_as_missing": true
        },
        {
          "name": "gclid",
