      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "cust_params",
      "description": "Custom targeting is an encoded query of key=value pairs joined by ampersands. A key may have comma-separated values.",
      "doc": "https://support.google.com/admanager/answer/1080597",
      "format": {
        "kind": "regex",
        "pattern": "^[^=&]+=[^&]*(?:&[^=&]+=[^&]*)*$"
      }
    },
    {
      "name": "ipd",
      "description": "The vendor documents `ipd` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "paln",
      "description": "The vendor documents `paln` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "pp",
      "description": "The vendor documents `pp` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "ppid",
      "description": "A publisher-provided ID has 22 to 150 characters from the documented alphanumeric and punctuation set. Its hash/encryption provenance requires external evidence.",
      "doc": "https://support.google.com/admanager/answer/2880055",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9A-Za-z+.=/_$,{\\}-]{22,150}$"
      },
      "min_length": 22,
      "max_length": 150
    },
    {
      "name": "ptpl",
      "description": "The vendor documents `ptpl` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "ptpln",
      "description": "The vendor documents `ptpln` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "pvid",
      "description": "The vendor documents `pvid` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "rdid",
      "description": "Resettable device identifiers contain 32 alphanumeric characters and four hyphens grouped 8-4-4-4-12.",
      "doc": "https://support.google.com/admanager/answer/6238701",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9A-Za-z]{8}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{12}$"
      }
    },
    {
      "name": "ssss",
      "description": "The vendor documents `ssss` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "addtl_consent",
      "description": "Google Additional Consent v1 or v2. ACv2 has consented IDs and a disclosed dv list; the dot after dv is optional only when that list is empty.",
      "doc": "https://support.google.com/admanager/answer/9681920",
      "format": {
        "kind": "additional_consent"
      },
      "fix_hint": "Send an ACv1 string such as 1~1.35 or an ACv2 string such as 2~1.10~dv.2.3.4."
