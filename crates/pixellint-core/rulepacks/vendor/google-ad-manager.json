      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "msid",
      "description": "The vendor documents `msid` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
      "format": {
        "kind": "non_empty"
      }
    },
    {
      "name": "ct_ch",
      "description": "The vendor documents `ct_ch` in the request contract.",
      "doc": "https://support.google.com/admanager/answer/10678356",
