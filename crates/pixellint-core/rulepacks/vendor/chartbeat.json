{
  "id": "vendor/chartbeat",
  "display_name": "Chartbeat ping",
  "description": "Chartbeat exact /ping collector with documented site, account and page context plus advisory SDK engagement counters, viewport metrics, one-hot activity flags and request method checks. Empty referrers and cached internal page paths remain valid. The loader, MAB and custom collector hosts remain outside this profile.",
  "vendor": "chartbeat",
  "source_level": "official_vendor",
  "docs": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration",
  "match": {
    "hosts": [
      "ping.chartbeat.net"
    ],
    "paths": [
      "/ping"
    ]
  },
  "params": [
    {
      "name": "h",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the Chartbeat site id, the host where traffic appears in the dashboard. Chartbeat documents it as the `config.domain` value on the ping.",
      "fix_hint": "Set `h` to the site id from the Chartbeat snippet, usually the site's root domain.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "g",
      "requirement": "required",
      "format": {
        "kind": "integer"
      },
      "description": "It is the numeric Chartbeat account UID from `config.uid`.",
      "fix_hint": "Set `g` to the numeric uid from the Chartbeat snippet.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "p",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the page path. Chartbeat documents it as a ping key to check in QA, from `config.path` or the canonical path.",
      "fix_hint": "Set `p` to the canonical path Chartbeat should report.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "d",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the actual domain of the page, which may differ from `h`. Chartbeat documents it as a ping key to check in QA.",
      "fix_hint": "Set `d` to the page's domain, or the canonical domain when `useCanonicalDomain` is true.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "t",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the unique identifier for the page-session. Chartbeat documents each distinct `t` as a separate pageview.",
      "fix_hint": "Send a stable page-session id in `t` so successive pings on the same view stay together.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "g0",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the comma-delimited list of sections from `config.sections`. Chartbeat documents it as a ping key to check in QA.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "g1",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the comma-delimited list of authors from `config.authors`. Chartbeat documents it as a ping key to check in QA.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration"
    },
    {
      "name": "i",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the page title. Chartbeat documents it as present on the first ping of a page-session.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration",
      "allow_empty": true
    },
    {
      "name": "r",
      "description": "The vendor documents `r` in the request contract.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration",
      "format": {
        "kind": "url"
      },
      "allow_empty": true
    },
    {
      "name": "v",
      "description": "Internal referrer. The SDK sends either a URL or a cached previous page path.",
      "doc": "https://docs.chartbeat.com/cbp/tracking/standard-websites/qa-web-integration",
      "allow_empty": true
    },
    {
      "name": "c",
      "description": "Elapsed seconds since the page-view start.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "x",
      "description": "Current scroll position, floored by the SDK.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "m",
      "description": "Maximum observed scroll position.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "y",
      "description": "Document scroll height.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "o",
      "description": "Document scroll width.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "w",
      "description": "Viewport client height.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "j",
      "description": "Scheduled ping interval in seconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "E",
      "description": "Cumulative engaged seconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "e",
      "description": "Engaged seconds since the previous ping.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "tz",
      "description": "Signed timezone offset in minutes.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "sn",
      "description": "Ping sequence counter.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "V",
      "description": "Producer version number.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": false,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "b",
      "description": "Navigation timing value when available.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "R",
      "description": "Producer activity or HUD flag, encoded as 0 or 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "W",
      "description": "Producer activity or HUD flag, encoded as 0 or 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "I",
      "description": "Producer activity or HUD flag, encoded as 0 or 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "L",
      "description": "Producer activity or HUD flag, encoded as 0 or 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "nc",
      "description": "Optional producer marker encoded as 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "vp",
      "description": "Optional producer marker encoded as 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "C",
      "description": "Optional producer marker encoded as 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "l",
      "description": "Optional producer marker encoded as 1.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "im",
      "description": "Producer image capability mask.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^[a-fA-F0-9]{8}$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    },
    {
      "name": "l1",
      "description": "Cached internal page counter.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9]+$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    }
  ],
  "rules": [
    {
      "code": "vendor.chartbeat.activity_flags_conflict",
      "kind": "forbid_value_pattern",
      "params": [
        "R"
      ],
      "pattern": "^[01]$",
      "condition": {
        "kind": "all",
        "conditions": [
          {
            "kind": "all",
            "conditions": [
              {
                "kind": "exists",
                "param": "R"
              },
              {
                "kind": "exists",
                "param": "W"
              },
              {
                "kind": "exists",
                "param": "I"
              }
            ]
          },
          {
            "kind": "any",
            "conditions": [
              {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "value_in",
                    "param": "R",
                    "values": [
                      "0"
                    ]
                  },
                  {
                    "kind": "value_in",
                    "param": "W",
                    "values": [
                      "0"
                    ]
                  },
                  {
                    "kind": "value_in",
                    "param": "I",
                    "values": [
                      "0"
                    ]
                  }
                ]
              },
              {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "value_in",
                    "param": "R",
                    "values": [
                      "1"
                    ]
                  },
                  {
                    "kind": "value_in",
                    "param": "W",
                    "values": [
                      "1"
                    ]
                  }
                ]
              },
              {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "value_in",
                    "param": "R",
                    "values": [
                      "1"
                    ]
                  },
                  {
                    "kind": "value_in",
                    "param": "I",
                    "values": [
                      "1"
                    ]
                  }
                ]
              },
              {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "value_in",
                    "param": "W",
                    "values": [
                      "1"
                    ]
                  },
                  {
                    "kind": "value_in",
                    "param": "I",
                    "values": [
                      "1"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "severity": "warning",
      "message": "The pinned producer sets exactly one of R, W and I to 1 per ping.",
      "source_level": "official_template",
      "doc": "https://static.chartbeat.com/js/chartbeat.js"
    }
  ],
  "http": {
    "params": [
      {
        "name": "method",
        "description": "Pinned browser collector transport.",
        "requirement": "recommended",
        "format": {
          "kind": "enum",
          "values": [
            "GET"
          ]
        },
        "severity": "warning",
        "source_level": "official_template",
        "doc": "https://static.chartbeat.com/js/chartbeat.js"
      }
    ],
    "rules": []
  }
}
