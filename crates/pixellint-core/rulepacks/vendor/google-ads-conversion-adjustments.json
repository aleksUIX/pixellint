{
  "id": "vendor/google-ads-conversion-adjustments",
  "display_name": "Google Ads conversion adjustment upload",
  "vendor": "google",
  "description": "Conversion adjustments posted to the Google Ads API UploadConversionAdjustments method. Click uploads stay vendor/google-ads-click-conversions. Call uploads stay vendor/google-ads-call-conversions.",
  "source_level": "official_vendor",
  "docs": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
  "match": {
    "hosts": [
      "googleads.googleapis.com"
    ],
    "path_contains": [
      "uploadConversionAdjustments"
    ],
    "json_paths": [
      {
        "any_of": [
          "conversionAdjustments[].adjustmentType",
          "conversionAdjustments[].adjustment_type",
          "conversion_adjustments[].adjustmentType",
          "conversion_adjustments[].adjustment_type",
          "conversionAdjustments[].adjustmentDateTime",
          "conversionAdjustments[].adjustment_date_time",
          "conversion_adjustments[].adjustmentDateTime",
          "conversion_adjustments[].adjustment_date_time"
        ]
      }
    ]
  },
  "body": [
    {
      "params": [
        {
          "name": "conversionAdjustments",
          "requirement": "required",
          "description": "UploadConversionAdjustments requires a `conversionAdjustments` array.",
          "fix_hint": "Send at least one ConversionAdjustment in `conversionAdjustments`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "array",
          "min_items": 1,
          "max_items": 2000,
          "aliases": [
            "conversion_adjustments"
          ],
          "null_as_missing": true
        },
        {
          "name": "partialFailure",
          "requirement": "required",
          "format": {
            "kind": "enum",
            "values": [
              "true"
            ]
          },
          "description": "Google documents `partial_failure` as required, and the upload guides say to always send true.",
          "fix_hint": "Set `partialFailure` to `true`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "boolean",
          "aliases": [
            "partial_failure"
          ],
          "null_as_missing": true
        },
        {
          "name": "conversionAdjustments[]",
          "description": "The vendor documents `conversionAdjustments[]` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "object",
          "aliases": [
            "conversion_adjustments[]"
          ]
        },
        {
          "name": "validateOnly",
          "description": "The vendor documents `validateOnly` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "boolean",
          "aliases": [
            "validate_only"
          ],
          "null_as_missing": true
        },
        {
          "name": "",
          "description": "The vendor documents `` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "object"
        }
      ],
      "rules": []
    },
    {
      "scope": [
        "conversionAdjustments[]",
        "conversion_adjustments[]"
      ],
      "params": [
        {
          "name": "conversionAction",
          "requirement": "required",
          "format": {
            "kind": "non_empty"
          },
          "description": "It is the conversion action resource name, and every uploaded adjustment requires it.",
          "fix_hint": "Set `conversionAction` to `customers/{id}/conversionActions/{id}`.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v24/ConversionAdjustment",
          "json_type": "string",
          "aliases": [
            "conversion_action"
          ],
          "null_as_missing": true
        },
        {
          "name": "adjustmentType",
          "requirement": "required",
          "format": {
            "kind": "enum",
            "values": [
              "RETRACTION",
              "RESTATEMENT",
              "ENHANCEMENT",
              "2",
              "3",
              "4"
            ]
          },
          "description": "Google documents `RETRACTION`, `RESTATEMENT`, and `ENHANCEMENT`.",
          "fix_hint": "Set `adjustmentType` to `RETRACTION`, `RESTATEMENT`, or `ENHANCEMENT`.",
          "doc": "https://raw.githubusercontent.com/googleapis/googleapis/master/google/ads/googleads/v24/enums/conversion_adjustment_type.proto",
          "json_type": [
            "string",
            "integer"
          ],
          "aliases": [
            "adjustment_type"
          ],
          "null_as_missing": true
        },
        {
          "name": "adjustmentDateTime",
          "format": {
            "kind": "regex",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "description": "Google documents the adjustment time with a timezone offset as `yyyy-mm-dd hh:mm:ss+|-hh:mm`.",
          "fix_hint": "Send a timestamp such as `2026-08-21 12:00:00+00:00`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "string",
          "aliases": [
            "adjustment_date_time"
          ],
          "null_as_missing": true
        },
        {
          "name": "orderId",
          "format": {
            "kind": "non_empty"
          },
          "description": "It identifies the conversion to adjust. Google documents `orderId` as the recommended identifier.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "string",
          "aliases": [
            "order_id"
          ],
          "null_as_missing": true
        },
        {
          "name": "gclidDateTimePair.gclid",
          "format": {
            "kind": "non_empty"
          },
          "description": "Google click ID plus conversion time, as an alternative to `orderId`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "string",
          "aliases": [
            "gclid_date_time_pair.gclid"
          ],
          "null_as_missing": true
        },
        {
          "name": "gclidDateTimePair.conversionDateTime",
          "format": {
            "kind": "regex",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "description": "The original conversion time when identifying via `gclidDateTimePair`. Same timestamp shape as `adjustmentDateTime`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "string",
          "aliases": [
            "gclidDateTimePair.conversion_date_time",
            "gclid_date_time_pair.conversionDateTime",
            "gclid_date_time_pair.conversion_date_time"
          ],
          "null_as_missing": true
        },
        {
          "name": "restatementValue.adjustedValue",
          "format": {
            "kind": "regex",
            "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|NaN|-?Infinity)$"
          },
          "description": "The restated conversion value. Google documents it as required on `RESTATEMENT` and invalid on `RETRACTION`.",
          "fix_hint": "Set `restatementValue.adjustedValue` to the new conversion value.",
          "doc": "https://protobuf.dev/programming-guides/json/",
          "json_type": [
            "number",
            "string"
          ],
          "aliases": [
            "restatementValue.adjusted_value",
            "restatement_value.adjustedValue",
            "restatement_value.adjusted_value"
          ],
          "null_as_missing": true
        },
        {
          "name": "restatementValue.currencyCode",
          "format": {
            "kind": "regex",
            "pattern": "^[A-Za-z]{3}$"
          },
          "description": "It is an ISO 4217 currency code for `adjustedValue`.",
          "fix_hint": "Use the three-letter code, such as `USD`.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v24/RestatementValue",
          "json_type": "string",
          "aliases": [
            "restatementValue.currency_code",
            "restatement_value.currencyCode",
            "restatement_value.currency_code"
          ],
          "null_as_missing": true
        },
        {
          "name": "consent",
          "description": "The vendor documents `consent` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "object",
          "null_as_missing": true
        },
        {
          "name": "restatementValue",
          "description": "The vendor documents `restatementValue` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "object",
          "aliases": [
            "restatement_value"
          ],
          "null_as_missing": true
        },
        {
          "name": "gclidDateTimePair",
          "description": "The vendor documents `gclidDateTimePair` in the request contract.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments",
          "json_type": "object",
          "aliases": [
            "gclid_date_time_pair"
          ],
          "null_as_missing": true
        },
        {
          "name": "userIdentifiers",
          "json_type": "array",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "max_items": 5,
          "aliases": [
            "user_identifiers"
          ],
          "null_as_missing": true
        },
        {
          "name": "userIdentifiers[]",
          "json_type": "object",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "aliases": [
            "user_identifiers[]"
          ]
        },
        {
          "name": "userAgent",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "aliases": [
            "user_agent"
          ],
          "null_as_missing": true
        }
      ],
      "rules": [
        {
          "code": "vendor.google-ads-conversion-adjustments.body.order_or_gclid_required",
          "kind": "require_one_of",
          "params": [
            "orderId",
            "gclidDateTimePair.gclid"
          ],
          "severity": "error",
          "message": "The adjustment has neither `orderId` nor `gclidDateTimePair.gclid`. Google documents one of them as required so the conversion can be identified.",
          "fix_hint": "Send `orderId`, or send `gclidDateTimePair` with `gclid` and `conversionDateTime`.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments"
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.gclid_requires_conversion_time",
          "kind": "required_with",
          "when": "gclidDateTimePair.gclid",
          "requires": [
            "gclidDateTimePair.conversionDateTime"
          ],
          "severity": "error",
          "message": "The adjustment sends `gclidDateTimePair.gclid` without `conversionDateTime`. Google documents the pair together.",
          "fix_hint": "Set `gclidDateTimePair.conversionDateTime` to the original conversion time.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments"
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.restatement_requires_value",
          "kind": "required_when_value",
          "when": "adjustmentType",
          "equals": [
            "RESTATEMENT",
            "3"
          ],
          "requires": [
            "restatementValue.adjustedValue"
          ],
          "severity": "error",
          "message": "A `RESTATEMENT` has no `restatementValue.adjustedValue`. Google documents the restated value as required.",
          "fix_hint": "Set `restatementValue.adjustedValue` to the new conversion value.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments"
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.retraction_forbids_value",
          "kind": "forbidden_when_value",
          "when": "adjustmentType",
          "equals": [
            "RETRACTION",
            "2"
          ],
          "params": [
            "restatementValue"
          ],
          "severity": "error",
          "message": "A `RETRACTION` carries `restatementValue.adjustedValue`. Google documents that field as required on `RESTATEMENT` and invalid on a retraction.",
          "fix_hint": "Drop `restatementValue` from a retraction.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment"
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.adjustment_time_required",
          "kind": "required_when_value",
          "severity": "error",
          "message": "The request does not satisfy the documented adjustment time required requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "when": "adjustmentType",
          "equals": [
            "RETRACTION",
            "RESTATEMENT",
            "2",
            "3"
          ],
          "requires": [
            "adjustmentDateTime"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.enhancement_order_required",
          "kind": "required_when_value",
          "severity": "error",
          "message": "The request does not satisfy the documented enhancement order required requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "when": "adjustmentType",
          "equals": [
            "ENHANCEMENT",
            "4"
          ],
          "requires": [
            "orderId"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.user_identifiers_enhancement_only",
          "kind": "forbidden_when_value",
          "severity": "error",
          "message": "The request does not satisfy the documented user identifiers enhancement only requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "when": "adjustmentType",
          "equals": [
            "RETRACTION",
            "RESTATEMENT",
            "2",
            "3"
          ],
          "params": [
            "userIdentifiers"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.user_agent_enhancement_only",
          "kind": "forbidden_when_value",
          "severity": "error",
          "message": "The request does not satisfy the documented user agent enhancement only requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "when": "adjustmentType",
          "equals": [
            "RETRACTION",
            "RESTATEMENT",
            "2",
            "3"
          ],
          "params": [
            "userAgent"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.user_agent_requires_identifiers",
          "kind": "required_with",
          "severity": "error",
          "message": "The request does not satisfy the documented user agent requires identifiers requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/ConversionAdjustment",
          "when": "userAgent",
          "requires": [
            "userIdentifiers"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.adjustmentDateTime.calendar_invalid",
          "kind": "format",
          "param": "adjustmentDateTime",
          "format": {
            "kind": "datetime",
            "require_timezone": true,
            "allow_space_separator": true
          },
          "condition": {
            "kind": "value_pattern",
            "param": "adjustmentDateTime",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "severity": "error",
          "message": "The conversion timestamp must represent a valid calendar date, time and timezone offset.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments"
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.gclidDateTimePair.conversionDateTime.calendar_invalid",
          "kind": "format",
          "param": "gclidDateTimePair.conversionDateTime",
          "format": {
            "kind": "datetime",
            "require_timezone": true,
            "allow_space_separator": true
          },
          "condition": {
            "kind": "value_pattern",
            "param": "gclidDateTimePair.conversionDateTime",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "severity": "error",
          "message": "The conversion timestamp must represent a valid calendar date, time and timezone offset.",
          "doc": "https://developers.google.com/google-ads/api/docs/conversions/upload-adjustments"
        }
      ]
    },
    {
      "scope": [
        "conversionAdjustments[].userIdentifiers[]",
        "conversionAdjustments[].user_identifiers[]",
        "conversion_adjustments[].userIdentifiers[]",
        "conversion_adjustments[].user_identifiers[]"
      ],
      "params": [
        {
          "name": "",
          "json_type": "object",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier"
        },
        {
          "name": "hashedEmail",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "format": {
            "kind": "regex",
            "pattern": "^[a-f0-9]{64}$"
          },
          "aliases": [
            "hashed_email"
          ],
          "null_as_missing": true
        },
        {
          "name": "hashedPhoneNumber",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "format": {
            "kind": "regex",
            "pattern": "^[a-f0-9]{64}$"
          },
          "aliases": [
            "hashed_phone_number"
          ],
          "null_as_missing": true
        },
        {
          "name": "userIdentifierSource",
          "json_type": [
            "string",
            "integer"
          ],
          "doc": "https://raw.githubusercontent.com/googleapis/googleapis/master/google/ads/googleads/v24/enums/user_identifier_source.proto",
          "format": {
            "kind": "enum",
            "values": [
              "UNSPECIFIED",
              "FIRST_PARTY",
              "THIRD_PARTY",
              "0",
              "2",
              "3"
            ]
          },
          "aliases": [
            "user_identifier_source"
          ],
          "null_as_missing": true
        },
        {
          "name": "mobileId",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "requirement": "forbidden",
          "aliases": [
            "mobile_id"
          ],
          "null_as_missing": true
        },
        {
          "name": "thirdPartyUserId",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "requirement": "forbidden",
          "aliases": [
            "third_party_user_id"
          ],
          "null_as_missing": true
        },
        {
          "name": "addressInfo",
          "json_type": "object",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "aliases": [
            "address_info"
          ],
          "null_as_missing": true
        }
      ],
      "rules": [
        {
          "code": "vendor.google-ads-conversion-adjustments.body.identifier_required",
          "kind": "require_one_of",
          "severity": "error",
          "message": "The request does not satisfy the documented identifier required requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "params": [
            "hashedEmail",
            "hashedPhoneNumber",
            "addressInfo"
          ]
        },
        {
          "code": "vendor.google-ads-conversion-adjustments.body.identifier_oneof",
          "kind": "mutually_exclusive",
          "severity": "error",
          "message": "The request does not satisfy the documented identifier oneof requirement.",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier",
          "params": [
            "hashedEmail",
            "hashedPhoneNumber",
            "addressInfo"
          ]
        }
      ]
    },
    {
      "scope": [
        "conversionAdjustments[].userIdentifiers[].addressInfo",
        "conversionAdjustments[].userIdentifiers[].address_info",
        "conversionAdjustments[].user_identifiers[].addressInfo",
        "conversionAdjustments[].user_identifiers[].address_info",
        "conversion_adjustments[].userIdentifiers[].addressInfo",
        "conversion_adjustments[].userIdentifiers[].address_info",
        "conversion_adjustments[].user_identifiers[].addressInfo",
        "conversion_adjustments[].user_identifiers[].address_info"
      ],
      "params": [
        {
          "name": "",
          "json_type": "object",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/UserIdentifier"
        },
        {
          "name": "hashedFirstName",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "format": {
            "kind": "regex",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirement": "required",
          "aliases": [
            "hashed_first_name"
          ],
          "null_as_missing": true
        },
        {
          "name": "hashedLastName",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "format": {
            "kind": "regex",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirement": "required",
          "aliases": [
            "hashed_last_name"
          ],
          "null_as_missing": true
        },
        {
          "name": "hashedStreetAddress",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "format": {
            "kind": "regex",
            "pattern": "^[a-f0-9]{64}$"
          },
          "aliases": [
            "hashed_street_address"
          ],
          "null_as_missing": true
        },
        {
          "name": "countryCode",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "requirement": "required",
          "format": {
            "kind": "regex",
            "pattern": "^[A-Za-z]{2}$"
          },
          "aliases": [
            "country_code"
          ],
          "null_as_missing": true
        },
        {
          "name": "postalCode",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "requirement": "required",
          "aliases": [
            "postal_code"
          ],
          "null_as_missing": true
        },
        {
          "name": "city",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "null_as_missing": true
        },
        {
          "name": "state",
          "json_type": "string",
          "doc": "https://developers.google.com/google-ads/api/reference/rpc/v25/OfflineUserAddressInfo",
          "null_as_missing": true
        }
      ],
      "rules": []
    }
  ]
}
