{
  "id": "vendor/comscore",
  "display_name": "Comscore beacon",
  "description": "Documented legacy Comscore Direct /b and /p publisher beacons. Requires c1=2, the assigned seven-digit c2 and full page URL c7. Configured modern SDK requests identified by cs_cfg have a separate source profile that respects disabled URL collection and truncation.",
  "vendor": "comscore",
  "source_level": "official_vendor",
  "docs": "https://direct-support.comscore.com/hc/en-us/articles/360002578333-How-can-I-validate-my-tag-is-working-as-intended",
  "match": {
    "hosts": [
      "b.scorecardresearch.com",
      "sb.scorecardresearch.com"
    ],
    "paths": [
      "/b",
      "/p"
    ],
    "query_params_none": [
      "cs_cfg"
    ]
  },
  "params": [
    {
      "name": "c1",
      "requirement": "required",
      "format": {
        "kind": "enum",
        "values": [
          "2"
        ]
      },
      "description": "Comscore documents `c1=2` on the publisher beacon.",
      "fix_hint": "Set `c1` to `2` as in the generated Comscore Direct tag.",
      "doc": "https://direct-support.comscore.com/hc/en-us/articles/360002578333-How-can-I-validate-my-tag-is-working-as-intended"
    },
    {
      "name": "c2",
      "requirement": "required",
      "format": {
        "kind": "integer",
        "min_digits": 7,
        "max_digits": 7
      },
      "description": "It is the seven-digit client ID assigned by Comscore Direct.",
      "fix_hint": "Set `c2` to the seven-digit client ID from Comscore Direct.",
      "doc": "https://direct-support.comscore.com/hc/en-us/articles/360002578333-How-can-I-validate-my-tag-is-working-as-intended"
    },
    {
      "name": "c7",
      "requirement": "required",
      "format": {
        "kind": "url"
      },
      "description": "It is the full page URL, including the query string. Comscore documents it as required on the final `/b` tag call.",
      "fix_hint": "Set `c7` to the absolute URL of the page that fired the beacon.",
      "doc": "https://direct-support.comscore.com/hc/en-us/articles/360002578333-How-can-I-validate-my-tag-is-working-as-intended"
    },
    {
      "name": "c8",
      "description": "Optional document title.",
      "requirement": "optional",
      "allow_empty": true,
      "source_level": "official_template",
      "doc": "https://sb.scorecardresearch.com/beacon.js"
    },
    {
      "name": "c9",
      "description": "Optional document referrer.",
      "requirement": "optional",
      "format": {
        "kind": "url"
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://sb.scorecardresearch.com/beacon.js"
    },
    {
      "name": "ns__t",
      "description": "The SDK stamps epoch milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "integer"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://sb.scorecardresearch.com/beacon.js"
    },
    {
      "name": "ns_if",
      "description": "Optional SDK binary flag. Blank fallback values remain valid.",
      "requirement": "optional",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "allow_empty": true,
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://sb.scorecardresearch.com/beacon.js"
    },
