{
  "id": "vendor/google-analytics-collect",
  "display_name": "Google Analytics 4 gtag collect",
  "description": "GA4 browser /g/collect query transports. Adds source-profile checks for populated page metadata, session counters, numeric event and user property families, screen size and binary flags. Custom names, string properties, consent encodings and product tuples remain open. Plaintext multi-event batch bodies are outside this query profile.",
  "vendor": "google",
  "source_level": "ecosystem_reference",
  "docs": "https://developers.google.com/analytics/devguides/collection/ga4",
  "match": {
    "host_suffixes": [
      "google-analytics.com"
    ],
    "hosts": [
      "analytics.google.com"
    ],
    "paths": [
      "/g/collect",
      "/g/collect/",
      "/debug/g/collect",
      "/debug/g/collect/"
    ]
  },
  "params": [
    {
      "name": "v",
      "requirement": "required",
      "format": {
        "kind": "enum",
        "values": [
          "2"
        ]
      },
      "format_severity": "warning",
      "description": "GA4 collection uses protocol version 2. Version 1 is Universal Analytics, which stopped processing data.",
      "fix_hint": "Send `v=2` from a Google tag configured for a GA4 property.",
      "doc": "https://developers.google.com/analytics/devguides/collection/ga4"
    },
    {
      "name": "tid",
      "requirement": "required",
      "format": {
        "kind": "regex",
        "pattern": "^G-[A-Za-z0-9]+$"
      },
      "format_severity": "warning",
      "description": "It is the GA4 measurement ID, which starts with `G-`. A `UA-` value here is a Universal Analytics property that no longer collects data.",
      "fix_hint": "Point the tag at a GA4 measurement ID.",
      "doc": "https://developers.google.com/analytics/devguides/collection/ga4"
    },
    {
      "name": "cid",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the client ID that ties events to one browser. Without it, hits cannot be attributed to a session.",
      "doc": "https://developers.google.com/analytics/devguides/collection/ga4"
    },
    {
      "name": "en",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the event name.",
      "doc": "https://developers.google.com/analytics/devguides/collection/ga4"
    },
    {
      "name": "dl",
      "description": "The producer sends an absolute page or referrer URL. Blank referrers remain valid.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://www.googletagmanager.com/gtag/js?id=G-SYNTHETIC0",
      "format": {
        "kind": "url"
      },
      "allow_empty": true
    },
    {
      "name": "dr",
      "description": "The producer sends an absolute page or referrer URL. Blank referrers remain valid.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://www.googletagmanager.com/gtag/js?id=G-SYNTHETIC0",
      "format": {
        "kind": "url"
      },
      "allow_empty": true
    },
    {
      "name": "dt",
      "description": "Document title remains an open string.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://www.googletagmanager.com/gtag/js?id=G-SYNTHETIC0",
      "allow_empty": true
    },
    {
      "name": "cu",
      "description": "The producer uses a three-letter currency token.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://www.googletagmanager.com/gtag/js?id=G-SYNTHETIC0",
      "format": {
        "kind": "regex",
        "pattern": "^[A-Z]{3}$"
      },
      "allow_empty": true
    },
    {
      "name": "sr",
      "description": "Browser screen dimensions use width x height.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://www.googletagmanager.com/gtag/js?id=G-SYNTHETIC0",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9]+x[0-9]+$"
      }
    },
    {
      "name": "sid",
      "description": "The browser producer emits a nonnegative integer counter or timestamp.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
