{
  "id": "vendor/exoclick-vast",
  "display_name": "ExoClick documented VAST registration templates",
  "vendor": "exoclick",
  "source_level": "official_template",
  "docs": "https://docs.exoclick.com/publishers/vast/vast-tag.md",
  "description": "Warning-level action, zone and progress completeness advice for documented vregister templates on the current default syndication host. Opaque data/d/dg carriers, click.php, cimp.php, identifier formats and receiver-wide requirements remain uncontracted.",
  "match": {
    "hosts": [
      "s.magsrv.com"
    ],
    "paths": [
      "/vregister.php"
    ]
  },
  "path_pattern": "^/(?<callback_route>vregister\\.php)$",
  "params": [
    {
      "name": "callback_route",
      "description": "Path-derived callback branch; a query name cannot supply this route.",
      "requirement": "optional",
      "allow_empty": false,
      "severity": "warning"
    },
    {
      "name": "a",
      "description": "The documented vregister callback templates include an action. Unlisted literal actions remain accepted.",
      "requirement": "recommended",
      "allow_empty": true,
      "severity": "warning",
      "condition": {
        "kind": "all_values_in",
        "params": [
          "callback_route"
        ],
        "values": [
          "vregister.php"
        ]
      }
    },
    {
      "name": "tracking_event",
      "description": "The documented vimp impression template includes tracking_event. Unlisted event values remain accepted, and the error template does not need this carrier.",
      "requirement": "recommended",
      "allow_empty": true,
      "severity": "warning",
      "condition": {
        "kind": "all",
        "conditions": [
          {
            "kind": "all_values_in",
            "params": [
              "callback_route"
            ],
            "values": [
              "vregister.php"
            ]
          },
          {
            "kind": "all_values_in",
            "params": [
              "a"
            ],
            "values": [
              "vimp"
            ]
          }
        ]
      }
    },
    {
      "name": "idzone",
      "description": "The documented impression, progress and error templates carry a provisioned zone reference. Advise on presence only in those recognizable branches; no digit, nonempty or account-validity rule is inferred.",
      "requirement": "recommended",
      "allow_empty": true,
      "severity": "warning",
      "condition": {
        "kind": "any",
        "conditions": [
          {
            "kind": "all",
            "conditions": [
              {
                "kind": "all_values_in",
                "params": [
                  "callback_route"
                ],
                "values": [
                  "vregister.php"
                ]
              },
              {
                "kind": "all_values_in",
                "params": [
                  "a"
                ],
                "values": [
                  "vimp"
                ]
              },
              {
                "kind": "all_values_in",
                "params": [
                  "tracking_event"
                ],
                "values": [
                  "impression"
                ]
              }
            ]
          },
          {
            "kind": "all",
            "conditions": [
              {
                "kind": "all_values_in",
                "params": [
                  "callback_route"
                ],
                "values": [
                  "vregister.php"
                ]
              },
              {
                "kind": "all_values_in",
                "params": [
                  "a"
                ],
                "values": [
                  "vview"
                ]
              },
              {
                "kind": "all_values_in",
                "params": [
                  "tracking_event"
                ],
                "values": [
                  "progress"
                ]
              }
            ]
          },
          {
            "kind": "all",
            "conditions": [
              {
                "kind": "all_values_in",
                "params": [
                  "callback_route"
                ],
                "values": [
                  "vregister.php"
                ]
              },
              {
                "kind": "all_values_in",
                "params": [
                  "a"
                ],
                "values": [
                  "vview"
                ]
              },
              {
                "kind": "exists",
                "param": "errorcode"
              },
              {
                "kind": "not",
                "condition": {
                  "kind": "exists",
                  "param": "tracking_event"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "data",
      "description": "The published VAST examples show an opaque data carrier but do not establish its requiredness or a universal receiver schema. Its absence stays valid. No equivalence with d or dg, token format, emptiness or payload meaning is inferred.",
      "requirement": "optional",
      "allow_empty": true,
      "severity": "warning"
    },
    {
      "name": "progress",
      "description": "The documented progress callback copies its offset. Advise on key presence only, retaining percentages, absolute offsets and unknown future encodings without inferred receiver format rules.",
      "requirement": "recommended",
      "allow_empty": true,
      "severity": "warning",
      "condition": {
        "kind": "all",
        "conditions": [
          {
            "kind": "all_values_in",
            "params": [
              "callback_route"
            ],
            "values": [
              "vregister.php"
            ]
          },
          {
            "kind": "all_values_in",
            "params": [
              "a"
            ],
            "values": [
              "vview"
            ]
          },
          {
            "kind": "all_values_in",
            "params": [
              "tracking_event"
            ],
            "values": [
              "progress"
            ]
          }
        ]
      }
    },
    {
      "name": "errorcode",
      "description": "The error template carries the VAST error-code macro. Its literal format, custom extensions, duplicate handling and requiredness on other vview branches are not inferred.",
      "requirement": "optional",
      "allow_empty": true,
      "severity": "warning"
    }
  ]
}
