{
  "id": "vendor/the-trade-desk-match",
  "display_name": "The Trade Desk generic cookie match",
  "description": "Published generic partner-initiated cookie mapping. Customized partner paths and private video measurement beacons are separate protocols.",
  "vendor": "thetradedesk",
  "source_level": "official_vendor",
  "docs": "https://www.thetradedesk.com/assets/global/Unified-ID-Adoption-Guidelines-for-SSPs-v1.8.pdf",
  "match": {
    "hosts": [
      "match.adsrvr.org"
    ],
    "paths": [
      "/track/cmf/generic"
    ]
  },
  "params": [
    {
      "name": "ttd_pid",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "Configured cookie mapping partner identifier. Its format is opaque.",
      "doc": "https://www.thetradedesk.com/assets/global/Unified-ID-Adoption-Guidelines-for-SSPs-v1.8.pdf"
    },
    {
      "name": "ttd_tpi",
      "requirement": "required",
      "format": {
        "kind": "enum",
        "values": [
          "1"
        ]
      },
      "description": "The documented generic URL marks a partner-initiated request with 1.",
      "doc": "https://www.thetradedesk.com/assets/global/Unified-ID-Adoption-Guidelines-for-SSPs-v1.8.pdf"
    }
  ],
  "http": {
    "params": [
      {
        "name": "method",
        "requirement": "required",
        "format": {
          "kind": "enum",
          "values": [
            "GET"
          ]
        },
        "description": "Published browser redirect and image request.",
        "doc": "https://www.thetradedesk.com/assets/global/Unified-ID-Adoption-Guidelines-for-SSPs-v1.8.pdf",
        "severity": "warning",
        "source_level": "official_template"
      }
    ]
  }
}
