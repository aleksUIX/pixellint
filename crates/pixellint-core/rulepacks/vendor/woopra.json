{
  "id": "vendor/woopra",
  "display_name": "Woopra event and identity collectors",
  "vendor": "woopra",
  "description": "Documented event and identity GET collectors plus pinned SDK v11 multipart NDJSON push batches. Checks each record independently. Enterprise identifiers, arbitrary event and visitor properties, custom tracking domains and account configuration require external context.",
  "docs": "https://docs.woopra.com/reference/track-ce",
  "source_level": "official_vendor",
  "match": {
    "hosts": [
      "www.woopra.com",
      "kr.track.airis.appier.net"
    ],
    "paths": [
      "/track/ce",
      "/track/ce/",
      "/track/identify",
      "/track/identify/",
      "/track/push",
      "/track/push/"
    ],
    "artifact_kinds": [
      "url",
      "vast",
      "postback",
      "request"
    ]
  },
  "params": [
    {
      "name": "operation",
      "description": "Collector operation from the endpoint path.",
      "requirement": "optional"
    },
    {
      "name": "payload",
      "description": "SDK push batches contain NDJSON.",
      "requirement": "optional"
    },
    {
      "name": "project",
      "description": "The configured project name.",
      "requirement": "required",
      "aliases": [
        "host"
      ],
      "format": {
        "kind": "non_empty"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "event",
      "description": "Event names are lowercase strings; spaces are allowed.",
      "requirement": "required",
      "format": {
        "kind": "regex",
        "pattern": "^[^A-Z]+$"
      },
      "condition": {
        "kind": "all",
        "conditions": [
          {
            "kind": "not",
            "condition": {
              "kind": "value_in",
              "param": "operation",
              "values": [
                "push"
              ]
            }
          },
          {
            "kind": "value_in",
            "param": "operation",
            "values": [
              "ce"
            ]
          }
        ]
      }
    },
    {
      "name": "cookie",
      "description": "Opaque visitor device cookie.",
      "requirement": "optional",
      "format": {
        "kind": "non_empty"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "cv_id",
      "description": "Optional configured visitor identity.",
      "requirement": "optional",
      "allow_empty": true,
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "cv_email",
      "description": "Optional visitor email identity.",
      "requirement": "optional",
      "allow_empty": true,
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "timestamp",
      "description": "Optional event time in Unix milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "ip",
      "description": "Optional visitor IPv4 or IPv6.",
      "requirement": "optional",
      "format": {
        "kind": "ip"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "timeout",
      "description": "Optional visit timeout in milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+$"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "referer",
      "description": "The legacy example accepts a schemeless referring URL.",
      "requirement": "optional",
      "allow_empty": true,
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "name": "redirect",
      "description": "Optional allowlisted redirect destination.",
      "requirement": "optional",
      "format": {
        "kind": "url"
      },
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    }
  ],
  "rules": [
    {
      "code": "vendor.woopra.identity_context",
      "kind": "require_one_of",
      "params": [
        "cookie",
        "cv_id",
        "cv_email"
      ],
      "severity": "info",
      "message": "Supply a cookie or a configured unique visitor property. Enterprise projects can configure identifiers beyond cv_id and cv_email.",
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "value_in",
          "param": "operation",
          "values": [
            "push"
          ]
        }
      }
    },
    {
      "code": "vendor.woopra.future_timestamp",
      "kind": "time_window",
      "param": "timestamp",
      "unit": "milliseconds",
      "max_future_seconds": 1,
      "severity": "error",
      "message": "Event timestamps cannot be in the future. A one-second tolerance matches the validator clock resolution.",
      "condition": {
        "kind": "all",
        "conditions": [
          {
            "kind": "not",
            "condition": {
              "kind": "value_in",
              "param": "operation",
              "values": [
                "push"
              ]
            }
          },
          {
            "kind": "value_pattern",
            "param": "timestamp",
            "pattern": "^[+-]?[0-9]+$"
          }
        ]
      }
    }
  ],
  "path_pattern": "^/track/(?<operation>ce|identify|push)/?$",
  "body": [
