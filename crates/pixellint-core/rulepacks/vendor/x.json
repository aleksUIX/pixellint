{
  "id": "vendor/x",
  "display_name": "X website tag",
  "description": "X website tag image and form collectors on exact /i/adsct and /i/adsctp routes. Adds pinned UWT 2.4.12 nested event objects and legacy event tuples, optional metadata and matching hashes. Custom event properties remain open. Conversions API has its own pack.",
  "vendor": "x",
  "source_level": "ecosystem_reference",
  "docs": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html",
  "match": {
    "hosts": [
      "analytics.twitter.com",
      "analytics.x.com",
      "t.co"
    ],
    "paths": [
      "/i/adsct",
      "/i/adsctp",
      "/1/i/adsct",
      "/1/i/adsctp"
    ]
  },
  "params": [
    {
      "name": "txn_id",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the conversion or pixel ID the website tag fires. X documents the JavaScript tag rather than this query, so the rule is ecosystem evidence.",
      "fix_hint": "Copy the conversion ID from the generated website tag so `txn_id` carries it.",
      "doc": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html"
    },
    {
      "name": "p_id",
      "requirement": "recommended",
      "format": {
        "kind": "enum",
        "values": [
          "Twitter"
        ]
      },
      "format_severity": "warning",
      "description": "Generated image pixels send `p_id=Twitter`.",
      "fix_hint": "Keep `p_id=Twitter` from the generated website tag.",
      "doc": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html"
    },
    {
      "name": "tw_sale_amount",
      "format": {
        "kind": "regex",
        "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
      },
      "format_severity": "warning",
      "description": "Purchase fires send the revenue amount. Generated pixels use a number with no currency symbol.",
      "fix_hint": "Set tw_sale_amount to a number such as 10 or 10.50, not $10.",
      "doc": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html"
    },
    {
      "name": "tw_order_quantity",
      "format": {
        "kind": "integer"
      },
      "format_severity": "warning",
      "description": "Purchase fires send the item count as an integer.",
      "fix_hint": "Set tw_order_quantity to the item count, digits only.",
      "doc": "https://business.twitter.com/en/help/campaign-measurement-and-analytics/conversion-tracking-for-websites.html"
    },
    {
      "name": "twclid",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the X click identifier from the landing URL. X documents twclid as a matching identifier on the pixel and the conversion API. Page fires without an ad click omit it.",
      "fix_hint": "Set twclid to the click ID from the landing URL query, or drop the pair when there was no click.",
      "doc": "https://developer.twitter.com/en/docs/twitter-ads-api/measurement/api-reference/conversions",
      "source_level": "official_vendor"
    },
    {
      "name": "tw_document_href",
