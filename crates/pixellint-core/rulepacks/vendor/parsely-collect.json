{
  "id": "vendor/parsely-collect",
  "display_name": "Parse.ly collect",
  "vendor": "parsely",
  "description": "Parse.ly tracker beacons on p1.parsely.com and p1-irl.parsely.com. The tracker loader on cdn.parsely.com is vendor/parsely.",
  "source_level": "official_vendor",
  "docs": "https://docs.parse.ly/tracker-details/",
  "match": {
    "hosts": [
      "p1.parsely.com",
      "p1-irl.parsely.com"
    ]
  },
  "params": [
    {
      "name": "idsite",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the Parse.ly Site ID. Parse.ly documents it as the site identifier on every collect beacon.",
      "fix_hint": "Set `idsite` to the Site ID from Parse.ly Support, such as `example.com`.",
      "doc": "https://docs.parse.ly/tracker-details/"
    },
    {
      "name": "url",
      "requirement": "required",
      "format": {
        "kind": "url"
      },
      "description": "It is the page URL. Parse.ly documents it as a full URL, not a relative path.",
      "fix_hint": "Send the absolute page URL in `url`.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/"
    },
    {
      "name": "action",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "Built-in events and custom event names are supported. A leading underscore on custom names is recommended to avoid collisions.",
      "fix_hint": "Send `action=pageview` for a page view.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/dynamic-tracking/"
    },
    {
      "name": "rand",
      "name_pattern": "^(rand|plid|sid|sts|slts|pvid|inc)$",
      "format": {
        "kind": "integer"
      },
      "description": "It is an integer tracker field. Parse.ly documents `rand` / `sts` / `slts` as millisecond timestamps, `plid` / `pvid` / `sid` as ids, and `inc` as heartbeat seconds. `slts` is `0` on a first session.",
      "fix_hint": "Send an integer, such as `0` or a millisecond timestamp.",
      "doc": "https://docs.parse.ly/tracker-details/"
    },
    {
      "name": "urlref",
      "allow_empty": true,
      "format": {
        "kind": "url"
      },
      "description": "It is the HTTP referrer. Parse.ly documents a full URL, or blank when the reader typed the address.",
      "fix_hint": "Send an absolute referrer URL in `urlref`, or leave it blank.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/"
    },
    {
      "name": "sref",
      "allow_empty": true,
      "format": {
        "kind": "url"
      },
      "description": "It is the session's first referrer. Parse.ly documents that it can be blank.",
      "fix_hint": "Send an absolute URL in `sref`, or leave it blank.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/"
    },
    {
      "name": "surl",
      "format": {
        "kind": "url"
      },
      "description": "It is the session's first pageview URL.",
      "fix_hint": "Send the absolute first-page URL in `surl`.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/",
      "allow_empty": false
    },
    {
      "name": "screen",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9]+x[0-9]+\\|[0-9]+x[0-9]+\\|[0-9]+$"
      },
      "description": "It is the client resolution. Parse.ly documents `WIDTHxHEIGHT|availableWIDTHxavailableHEIGHT|pixelDepth`.",
      "fix_hint": "Send `screen` as `1920x1080|1920x1040|24`.",
      "doc": "https://docs.parse.ly/tracker-details/"
    },
    {
      "name": "data",
      "allow_empty": true,
      "description": "It is optional JSON. Parse.ly documents conversions, audience segments, and custom data here, and allows a blank value.",
      "fix_hint": "Send a JSON object in `data`, or leave it blank.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/"
    },
    {
      "name": "title",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the content title shown in the Parse.ly dashboard.",
      "fix_hint": "Send the headline in `title`, or drop the empty pair.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/",
      "allow_empty": true
    },
    {
      "name": "date",
      "format": {
        "kind": "datetime",
        "allow_javascript_date": true
      },
      "description": "The live SDK sends Date.toString event time. Older tracker examples also use ISO 8601.",
      "fix_hint": "Send `date` as ISO 8601, such as `2026-09-20T15:41:53.000Z`.",
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    },
    {
      "name": "u",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the pseudonymous device UUID.",
      "fix_hint": "Send the device UUID in `u`, or drop the empty pair.",
      "doc": "https://docs.parse.ly/tracker-details/"
    },
    {
      "name": "sid",
      "description": "The vendor documents `sid` in the request contract.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/",
      "format": {
        "kind": "integer"
      },
      "minimum": 0
    },
    {
      "name": "sts",
      "description": "The vendor documents `sts` in the request contract.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/",
      "format": {
        "kind": "integer"
      },
      "minimum": 0
    },
    {
      "name": "slts",
      "description": "The vendor documents `slts` in the request contract.",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/",
      "format": {
        "kind": "integer"
      },
      "minimum": 0
    },
    {
      "name": "plid",
      "description": "The live SDK emits UUID or 32 hexadecimal correlation IDs. Older tracker documentation describes integer IDs.",
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
      "format": {
        "kind": "regex",
        "pattern": "^(?:-?[0-9]+|[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
      }
    },
    {
      "name": "pvid",
      "description": "The live SDK emits UUID or 32 hexadecimal correlation IDs. Older tracker documentation describes integer IDs.",
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
      "format": {
        "kind": "regex",
        "pattern": "^(?:-?[0-9]+|[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
      }
    },
    {
      "name": "inc",
      "format": {
        "kind": "integer"
      },
      "minimum": 0,
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
      "description": "Elapsed engaged seconds on heartbeat and video heartbeat events."
    },
    {
      "name": "js",
      "format": {
        "kind": "integer"
      },
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/dynamic-tracking/",
      "description": "The published dynamic tracking example supplies js=1."
    },
    {
      "name": "metadata",
      "allow_empty": true,
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
      "description": "Metadata supplied in tracker requests."
    },
    {
      "name": "vsid",
      "format": {
        "kind": "regex",
        "pattern": "^(?:-?[0-9]+|[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    },
    {
      "name": "tt",
      "format": {
        "kind": "integer"
      },
      "minimum": 0,
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
      "description": "Total engaged milliseconds from the SDK sampler."
    },
    {
      "name": "tpab",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
      "description": "Third-party analytics blocked flag."
    },
    {
      "name": "sl_xp",
      "format": {
        "kind": "non_empty"
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    },
    {
      "name": "sl_x",
      "format": {
        "kind": "integer"
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    },
    {
      "name": "sl_y",
      "format": {
        "kind": "integer"
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    },
    {
      "name": "sl_h",
      "format": {
        "kind": "url"
      },
      "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
    }
  ],
  "body": [
    {
      "source_param": "data",
      "encoding": "json",
      "params": [
        {
          "name": "",
          "json_type": "object",
          "doc": "https://docs.parse.ly/installation-resources/parsely-integration/tracking-code-setup/tracker-details/"
        },
        {
          "name": "parsely_uuid",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
          "description": "The SDK supplies this reserved identity value itself."
        },
        {
          "name": "parsely_site_uuid",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
          "description": "The SDK supplies this reserved identity value itself."
        }
      ],
      "rules": []
    },
    {
      "source_param": "data",
      "encoding": "json",
      "condition": {
        "kind": "value_in",
        "param": "action",
        "values": [
          "conversion"
        ]
      },
      "params": [
        {
          "name": "_conversion_type",
          "json_type": "string",
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
          "requirement": "required",
          "format": {
            "kind": "enum",
            "values": [
              "newsletter_signup",
              "lead_capture",
              "link_click",
              "subscription",
              "purchase",
              "custom",
              "active",
              "lead",
              "customer"
            ]
          }
        },
        {
          "name": "_conversion_label",
          "json_type": "string",
          "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
          "requirement": "required",
          "format": {
            "kind": "non_empty"
          }
        }
      ],
      "rules": [
        {
          "code": "vendor.parsely-collect.body.conversion_label_underscore",
          "kind": "forbid_value_pattern",
          "params": [
            "_conversion_label"
          ],
          "pattern": "_",
          "severity": "warning",
          "doc": "https://docs.parse.ly/installation-resources/add-on-features/set-up-conversion-tracking/javascript-conversion-tracking-setup/",
          "message": "Underscores in conversion labels cause unexpected Dashboard behavior."
        }
      ]
    },
    {
      "source_param": "metadata",
      "encoding": "json",
      "params": [
        {
          "name": "",
          "json_type": "object",
          "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/"
        },
        {
          "name": "title",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "link",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "image_url",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "pub_date",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "section",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "post_id",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "network_id",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "network_canonical",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "amphtmlurl",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "page_type",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "pub_metadata",
          "json_type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ],
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js",
          "description": "The SDK assigns leftover publication metadata as a native object. Caller custom metadata is open JSON; its nested metadata string is normalized separately. Do not infer a string-only wire field."
        },
        {
          "name": "authors",
          "json_type": "array",
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "tags",
          "json_type": "array",
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "authors[]",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "tags[]",
          "json_type": "string",
          "allow_empty": true,
          "doc": "https://cdn.parsely.com/keys/genericconfigfree/p.js"
        },
        {
          "name": "pub_metadata.metadata",
          "json_type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ],
          "max_length": 2000,
          "format_severity": "warning",
          "allow_empty": true,
          "doc": "https://docs.parse.ly/api/api-custom-metadata/",
          "description": "Custom metadata may contain arbitrary values. Published custom metadata strings over2000characters are ignored. This advisory counts Unicode characters of the normalized string."
        }
      ],
      "rules": [
        {
          "code": "vendor.parsely-collect.body.custom_metadata_json_recommended",
          "kind": "format",
          "param": "pub_metadata.metadata",
          "format": {
            "kind": "json"
          },
          "condition": {
            "kind": "json_type",
            "param": "pub_metadata.metadata",
            "json_type": "string"
          },
          "severity": "warning",
          "message": "Custom metadata is stored as an arbitrary string. Parse.ly recommends valid JSON.",
          "doc": "https://docs.parse.ly/api/api-custom-metadata/"
        }
      ]
    }
  ],
  "rules": [
    {
      "code": "vendor.parsely-collect.conversion_needs_data",
      "kind": "required_when_value",
      "severity": "error",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
      "message": "Conversion events carry their type and label in data.",
      "when": "action",
      "equals": [
        "conversion"
      ],
      "requires": [
        "data"
      ]
    },
    {
      "code": "vendor.parsely-collect.heartbeat_needs_inc",
      "kind": "required_when_value",
      "when": "action",
      "equals": [
        "heartbeat",
        "vheartbeat"
      ],
      "requires": [
        "inc"
      ],
      "severity": "warning",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
      "message": "A heartbeat without elapsed inc seconds cannot communicate engaged time."
    },
    {
      "code": "vendor.parsely-collect.invalid_site_id",
      "kind": "forbid_value_pattern",
      "severity": "error",
      "doc": "https://docs.parse.ly/installation-resources/parsely-integration/test-integration/",
      "message": "genericconfigfree indicates an invalid Site ID.",
      "params": [
        "idsite"
      ],
      "pattern": "^genericconfigfree$"
    }
  ]
}
