{
  "id": "vendor/google-ads-conversion",
  "display_name": "Google Ads conversion and remarketing pixel",
  "description": "Google Ads conversion and remarketing pixels on the exact /pagead/conversion/{id} and /pagead/viewthroughconversion/{id} route families. Legacy checks retain their profile; new advice follows the pinned cv=9, async=1 JavaScript producer. Remarketing does not require a conversion label. Other Google tag transports and receiver acceptance remain outside this review.",
  "vendor": "google",
  "source_level": "official_vendor",
  "docs": "https://support.google.com/tagassistant/answer/2947038",
  "path_pattern": "^/pagead/(?<tracking_route>conversion|viewthroughconversion)(?:/(?<conversion_id>[^/]*))?/?$",
  "match": {
    "host_suffixes": [
      "googleadservices.com",
      "googleads.g.doubleclick.net"
    ],
    "path_patterns": [
      "^/pagead/(?:viewthrough)?conversion(?:/[^/]*)?/?$"
    ]
  },
  "params": [
    {
      "name": "conversion_id",
      "requirement": "required",
      "format": {
        "kind": "integer"
      },
      "description": "It is the numeric conversion ID, unique per Google Ads account, and it travels in the path rather than the query.",
      "fix_hint": "Copy the conversion ID from the conversion action's tag setup.",
      "doc": "https://support.google.com/tagassistant/answer/2947038"
    },
    {
      "name": "label",
      "requirement": "recommended",
      "format": {
        "kind": "non_empty"
      },
      "description": "A conversion-action label is recommended on conversion hits. Remarketing requests may omit a conversion label.",
      "fix_hint": "Add the conversion label from the conversion action's tag setup.",
      "doc": "https://support.google.com/tagassistant/answer/2947038",
      "condition": {
        "kind": "value_in",
        "param": "tracking_route",
        "values": [
          "conversion"
        ]
      }
    },
    {
      "name": "value",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9]+(\\.[0-9]+)?$"
      },
      "description": "It is the conversion value. Google documents google_conversion_value as numbers and decimals only, with no currency symbol or comma.",
      "fix_hint": "Send a number such as 20 or 20.00, not $20.00.",
      "doc": "https://support.google.com/tagassistant/answer/2947038",
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "value_in",
              "param": "cv",
              "values": [
                "9"
              ]
            },
            {
              "kind": "value_in",
              "param": "async",
              "values": [
                "1"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "currency_code",
      "format": {
        "kind": "regex",
        "pattern": "^[A-Za-z]{3}$"
      },
      "description": "It is the ISO 4217 currency of `value`. Google documents it on conversion tags as `currency_code`.",
      "fix_hint": "Send the three-letter code, such as `USD`.",
      "doc": "https://support.google.com/tagassistant/answer/2947038"
    },
    {
      "name": "ord",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the cache buster on the image tag. Google documents a unique `ord` so repeat fires are counted separately.",
      "fix_hint": "Emit a fresh `ord` on every fire, or drop the empty pair.",
      "doc": "https://support.google.com/tagassistant/answer/2947038"
    },
    {
      "name": "guid",
      "format": {
        "kind": "enum",
        "values": [
          "ON"
        ]
      },
      "format_severity": "warning",
      "description": "The generated image tag sends `guid=ON`.",
      "doc": "https://support.google.com/tagassistant/answer/2947038"
    },
    {
      "name": "script",
      "format": {
        "kind": "enum",
        "values": [
          "0"
        ]
      },
      "format_severity": "warning",
      "description": "The image fallback sends `script=0` to say no JavaScript ran.",
      "doc": "https://support.google.com/tagassistant/answer/2947038"
    },
    {
      "name": "tracking_route",
      "description": "Captured endpoint distinguishes conversion-action labeling from remarketing.",
      "doc": "https://www.googleadservices.com/pagead/conversion_async.js"
    },
