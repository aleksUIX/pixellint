{
  "id": "vendor/adnami-tracker",
  "display_name": "Adnami tracker",
  "description": "Published Adnami SDK tracker construction and numeric telemetry. Advisory checks describe SDK output, not a complete private collector API.",
  "vendor": "adnami",
  "source_level": "official_template",
  "docs": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
  "match": {
    "hosts": [
      "functions.adnami.io"
    ],
    "paths": [
      "/api/tracker"
    ]
  },
  "params": [
    {
      "name": "ev",
      "description": "SDK event name. Public trackEvent accepts custom names.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "non_empty"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "cc",
      "description": "SDK creative code, including its all-zero error-report code.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "cs",
      "description": "SDK source URL after decoding.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "url"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "_",
      "description": "SDK event timestamp from Date.now.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "integer"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "sid",
      "description": "SDK opaque session ID, with numeric error-report IDs also supported.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "non_empty"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "sit",
      "description": "SDK session creation timestamp from Date.now.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "format": {
        "kind": "integer"
      },
      "requirement": "required",
      "severity": "warning"
    },
    {
      "name": "t",
      "description": "SDK numeric field: Elapsed event time.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "format": {
        "kind": "regex",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
      }
    },
    {
      "name": "ww",
      "description": "SDK numeric field: Viewport width.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "wh",
      "description": "SDK numeric field: Viewport height.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "aw",
      "description": "SDK numeric field: Ad width.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "ah",
      "description": "SDK numeric field: Ad height.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "vs",
      "description": "SDK numeric field: Viewed surface.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "format": {
        "kind": "regex",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
      }
    },
    {
      "name": "vsw",
      "description": "SDK numeric field: Viewed surface weight.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "format": {
        "kind": "regex",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
      }
    },
    {
      "name": "vr",
      "description": "SDK numeric field: Visible percentage.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0,
      "maximum": 100
    },
    {
      "name": "dist",
      "description": "SDK numeric field: Distance.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "format": {
        "kind": "regex",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
      }
    },
    {
      "name": "sw",
      "description": "SDK numeric field: Slot width.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "sh",
      "description": "SDK numeric field: Slot height.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "minimum": 0
    },
    {
      "name": "ff",
      "description": "SDK numeric field: Format factor.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "format": {
        "kind": "regex",
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
      }
    },
    {
      "name": "md",
      "description": "SDK metadata string. Caller strings need not be JSON.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "cd",
      "description": "SDK custom data encoded with btoa(JSON.stringify(value)).",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "aid",
      "description": "Ad unit identifier.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "app",
      "description": "Application label.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "pf",
      "description": "SDK platform detection.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "wd",
      "description": "SDK webdriver detection.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "dev",
      "description": "Device label.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "sz",
      "description": "Size label.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    },
    {
      "name": "v",
      "description": "SDK version.",
      "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
      "source_level": "official_template",
      "severity": "warning",
      "allow_empty": true
    }
  ],
  "body": {
    "source_param": "cd",
    "encoding": "base64_latin1_json",
    "params": [
      {
        "name": "",
        "description": "Custom data must decode as JSON using the SDK Latin-1 btoa encoding. The SDK serializer admits any JSON value.",
        "doc": "https://macro.adnami.io/macro/gen/adnm.ads.v2.js",
        "source_level": "official_template"
      }
    ],
    "encoding_severity": "warning"
  },
  "http": {
    "params": [
      {
        "name": "method",
        "requirement": "required",
        "format": {
          "kind": "enum",
          "values": [
            "GET",
            "POST"
          ]
        },
        "severity": "warning",
        "description": "Published SDK uses Image GET or sendBeacon POST, without requiring a body or Content-Type.",
        "doc": "https://macro.adnami.io/macro/gen/adnm.api.js",
        "source_level": "official_template"
      }
    ]
  }
}
