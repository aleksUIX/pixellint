{
  "id": "vendor/mouseflow",
  "display_name": "Mouseflow tracking script",
  "description": "Mouseflow project script on cdn.mouseflow.com/projects/{website_id}.js.",
  "vendor": "mouseflow",
  "source_level": "official_vendor",
  "docs": "https://help.mouseflow.com/en/articles/4312070-custom-variables",
  "path_pattern": "/projects/(?<website_id>[^/]+)\\.js",
  "match": {
    "hosts": ["cdn.mouseflow.com"],
    "path_contains": ["/projects/"]
  },
  "params": [
    {
      "name": "website_id",
      "requirement": "required",
      "format": { "kind": "non_empty" },
      "description": "It is the Mouseflow website ID. Mouseflow documents the loader as `cdn.mouseflow.com/projects/{website-id}.js`.",
      "fix_hint": "Copy the tracking code from Mouseflow so the path is `/projects/{websiteId}.js`.",
      "doc": "https://help.mouseflow.com/en/articles/4312070-custom-variables"
    }
  ],
  "rules": []
}
