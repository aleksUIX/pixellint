{
  "id": "vendor/pinterest",
  "display_name": "Pinterest Tag",
  "description": "Pinterest /v3 image and browser collectors, including JSON-encoded event, partner and automatic data in GET queries and POST forms. Noscript bracket fields retain documented checks. Custom events, arbitrary custom properties and SDK-supported hash arrays remain open. New browser checks are advisory.",
  "vendor": "pinterest",
  "source_level": "official_vendor",
  "docs": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/",
  "match": {
    "hosts": [
      "ct.pinterest.com"
    ],
    "paths": [
      "/v3",
      "/v3/"
    ]
  },
  "params": [
    {
      "name": "tid",
      "requirement": "required",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the Pinterest conversion tag ID.",
      "fix_hint": "Copy the tag ID from Ads Manager into `tid`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "event",
      "format": {
        "kind": "non_empty"
      },
      "format_severity": "warning",
      "description": "Standard and configured custom event names are accepted. The SDK forwards custom names after a console warning.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "noscript",
      "format": {
        "kind": "enum",
        "values": [
          "0",
          "1"
        ]
      },
      "format_severity": "warning",
      "description": "The image fallback in the base code sends `noscript=1`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[value]",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "description": "It is the purchase value on the noscript image. Pinterest documents `ed[value]` on checkout and add to cart tags.",
      "fix_hint": "Send a number in `ed[value]`, without a currency symbol.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[currency]",
      "format": {
        "kind": "currency",
        "case_insensitive": true
      },
      "description": "It is the ISO 4217 currency of `ed[value]`. Pinterest documents `ed[currency]` on the image tag.",
      "fix_hint": "Send a three-letter currency code in `ed[currency]`, such as `USD`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[order_quantity]",
      "format": {
        "kind": "integer"
      },
      "description": "It is the order quantity on the noscript image. Pinterest documents `ed[order_quantity]` next to `ed[value]`.",
      "fix_hint": "Send an integer item count in `ed[order_quantity]`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[event_id]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the event id on the noscript image. Pinterest documents `ed[event_id]` for deduplication against the JavaScript tag.",
      "fix_hint": "Send the same event id the JavaScript tag fired, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "pd[em]",
      "format": {
        "kind": "regex",
        "pattern": "^[A-Fa-f0-9]{64}$"
      },
      "description": "It is the hashed email for Enhanced Match on the image tag. Pinterest documents SHA-256 hex after lowercase and trim. The JavaScript tag hashes in the browser; the img tag does not.",
      "fix_hint": "Lowercase and trim the address, hash it with SHA-256, and send the hex digest in `pd[em]`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "pd[external_id]",
      "format": {
        "kind": "regex",
        "pattern": "^[A-Fa-f0-9]{64}$"
      },
      "description": "It is the hashed advertiser-side user id for Enhanced Match on the image tag. Pinterest documents SHA-256 hex.",
      "fix_hint": "Hash the identifier with SHA-256 and send the hex digest in `pd[external_id]`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_price]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_price\\]$",
      "format": {
        "kind": "regex",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "description": "It is a line-item price on the noscript image. Pinterest documents `ed[line_items][n][product_price]` as a number.",
      "fix_hint": "Send a number in `ed[line_items][n][product_price]`, without a currency symbol.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_quantity]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_quantity\\]$",
      "format": {
        "kind": "integer"
      },
      "description": "It is a line-item quantity on the noscript image. Pinterest documents `ed[line_items][n][product_quantity]` as an integer.",
      "fix_hint": "Send an integer item count in `ed[line_items][n][product_quantity]`.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_name]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_name\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item name on the noscript image. Pinterest documents `ed[line_items][n][product_name]` as a string.",
      "fix_hint": "Send the product name in `ed[line_items][n][product_name]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_id]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_id\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item product id on the noscript image. Pinterest documents `ed[line_items][n][product_id]` as a string.",
      "fix_hint": "Send the catalog product id in `ed[line_items][n][product_id]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_category]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_category\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item category on the noscript image. Pinterest documents `ed[line_items][n][product_category]` as a string.",
      "fix_hint": "Send the category in `ed[line_items][n][product_category]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_variant_id]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_variant_id\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item variant id on the noscript image. Pinterest documents `ed[line_items][n][product_variant_id]` as a string.",
      "fix_hint": "Send the variant id in `ed[line_items][n][product_variant_id]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_variant]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_variant\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item variant name on the noscript image. Pinterest documents `ed[line_items][n][product_variant]` as a string.",
      "fix_hint": "Send the variant name in `ed[line_items][n][product_variant]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[line_items][0][product_brand]",
      "name_pattern": "^ed\\[line_items\\]\\[[0-9]+\\]\\[product_brand\\]$",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a line-item brand on the noscript image. Pinterest documents `ed[line_items][n][product_brand]` as a string.",
      "fix_hint": "Send the brand in `ed[line_items][n][product_brand]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[order_id]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the order id on the noscript image. Pinterest documents `order_id` as a string for conversion reporting.",
      "fix_hint": "Send the order id in `ed[order_id]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[promo_code]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is a promotion code on the noscript image. Pinterest documents `promo_code` as a string.",
      "fix_hint": "Send the code in `ed[promo_code]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[property]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the store or property name on the noscript image. Pinterest documents `property` as a string.",
      "fix_hint": "Send the property name in `ed[property]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[search_query]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the search string on the noscript image. Pinterest documents `ed[search_query]` on search tags.",
      "fix_hint": "Send the query in `ed[search_query]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[video_title]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the video title on the noscript image. Pinterest documents `video_title` as a string.",
      "fix_hint": "Send the title in `ed[video_title]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed[lead_type]",
      "format": {
        "kind": "non_empty"
      },
      "description": "It is the lead type on the noscript image. Pinterest documents `lead_type` as a string.",
      "fix_hint": "Send the lead type in `ed[lead_type]`, or drop the empty pair.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/"
    },
    {
      "name": "ed",
      "description": "JSON string serialized by the browser producer.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://s.pinimg.com/ct/lib/main.cc6bb38d.js"
    },
    {
      "name": "pd",
      "description": "JSON string serialized by the browser producer.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://s.pinimg.com/ct/lib/main.cc6bb38d.js"
    },
    {
      "name": "ad",
      "description": "JSON string serialized by the browser producer.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://s.pinimg.com/ct/lib/main.cc6bb38d.js"
    },
    {
      "name": "ov",
      "description": "JSON string serialized by the browser producer.",
      "requirement": "optional",
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://s.pinimg.com/ct/lib/main.cc6bb38d.js"
    },
    {
      "name": "cb",
      "description": "Producer cache buster in Unix milliseconds.",
      "requirement": "optional",
      "format": {
        "kind": "regex",
        "pattern": "^[0-9]+$"
      },
      "severity": "warning",
      "source_level": "official_template",
      "doc": "https://s.pinimg.com/ct/lib/main.cc6bb38d.js"
    }
  ],
  "rules": [
    {
      "code": "vendor.pinterest.checkout_requires_value_and_currency",
      "kind": "required_when_value",
      "when": "event",
      "equals": [
        "checkout",
        "addtocart"
      ],
      "requires": [
        "ed[value]",
        "ed[currency]"
      ],
      "severity": "warning",
      "message": "A checkout or add-to-cart tag is missing `ed[value]` or `ed[currency]`. Pinterest documents those keys on the image tag for conversion reporting.",
      "fix_hint": "Add `ed[value]` and `ed[currency]` to the noscript image, or fire the event from JavaScript.",
      "doc": "https://developers.pinterest.com/docs/track-conversions/pinterest-tag/",
      "condition": {
        "kind": "not",
        "condition": {
          "kind": "exists",
          "param": "ed"
        }
      }
    }
  ],
