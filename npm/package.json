{
  "name": "pixellint",
  "version": "0.8.0",
  "description": "Validator for pixels, postbacks, conversion API payloads, and tracking URLs: spec-backed core rules, vendor rulepacks, and endpoint attribution",
  "license": "Apache-2.0",
  "author": "Aleks <aleks@vastlint.org>",
  "homepage": "https://github.com/aleksUIX/pixellint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksUIX/pixellint.git"
  },
  "keywords": [
    "pixel",
    "adtech",
    "tracking",
    "validator",
    "linter",
    "consent",
    "gdpr",
    "wasm"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "wasm/pixellint.js",
    "wasm/pixellint.d.ts",
    "wasm/pixellint_bg.wasm",
    "wasm/pixellint_bg.wasm.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.mjs"
  }
}
